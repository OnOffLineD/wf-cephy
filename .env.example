# WF-Companion Environment Configuration Example
# Copy this file to .env and adjust values if needed.

# [Optional] Custom directory path for user runtime data (checklist, builds, etc.)
# Defaults to ./data if unset
# WF_USER_DATA_DIR=./data

# [Optional] Force UTF-8 encoding for Windows terminals
PYTHONIOENCODING=utf-8

# [Optional] Local Ollama / LLM server URL (defaults to http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434
