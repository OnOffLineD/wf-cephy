# WF-Companion Environment Configuration Example
# Copy this file to .env and adjust values if needed.

# [Optional] Custom directory path for user runtime data (checklist, builds, etc.)
# Defaults to ./data if unset
# WF_USER_DATA_DIR=./data

# [Optional] Force UTF-8 encoding for Windows terminals
PYTHONIOENCODING=utf-8

# [Optional] Local Ollama / LLM server URL (defaults to http://localhost:11434)
# Used when Settings > AI engine is set to Ollama and no address is entered there.
# OLLAMA_HOST=http://localhost:11434

# [Optional] Hosted AI engine keys. Keys entered in Settings take priority and are stored
# DPAPI-encrypted in data/api_keys.json (git-ignored). These variables are the fallback and are
# read from the process environment (e.g. Windows user environment variables), not from this file.
# OLLAMA_API_KEY=   (remote Ollama behind an auth proxy, or ollama.com; sent as a Bearer token)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# WF_LLM_API_KEY=   (any OpenAI-compatible endpoint: OpenRouter, Groq, DeepSeek, LM Studio, ...)
