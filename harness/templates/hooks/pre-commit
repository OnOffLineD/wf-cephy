#!/bin/sh
# Harness² Pre-Commit Probe Hook
# Ensures that all 3 probe gates pass before allowing commit.

echo "[GIT HOOK] Running Harness² Probe Verification..."

if [ -f "scripts/probe.py" ]; then
    python scripts/probe.py
    RESULT=$?
elif [ -f "scripts/probe.mjs" ]; then
    node scripts/probe.mjs
    RESULT=$?
else
    echo "[GIT HOOK] Warning: No probe runner found in scripts/. Skipping probe."
    exit 0
fi

if [ $RESULT -ne 0 ]; then
    echo "============================================================"
    echo " [GIT HOOK ABORTED] Probe verification failed!"
    echo " Fix the errors reported by the probe runner before committing."
    echo "============================================================"
    exit 1
fi

echo "[GIT HOOK] Probe passed. Proceeding with commit."
exit 0
